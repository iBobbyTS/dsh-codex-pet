{
  "name": "codex-to-dsh-pet",
  "version": "0.1.0",
  "private": true,
  "description": "\u628a Codex \u684c\u5ba0\uff08spritesheet \u56fe\u96c6\uff09\u79fb\u690d\u4e3a DeepSeek Harness \u7f51\u9875 GUI \u684c\u5ba0\u7684\u901a\u7528\u6846\u67b6 / \u9002\u914d\u5668\u3002",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iBobbyTS/dsh-codex-pet.git"
  },
  "homepage": "https://github.com/iBobbyTS/dsh-codex-pet#readme",
  "bugs": {
    "url": "https://github.com/iBobbyTS/dsh-codex-pet/issues"
  },
  "packageManager": "pnpm@10.28.2",
  "devDependencies": {
    "typescript": "5.9.3",
    "tsdown": "0.22.14",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json",
    "build:runtime": "node scripts/build-runtime.mjs",
    "test": "node scripts/check.mjs test",
    "check:dist": "node scripts/check.mjs dist",
    "check": "node scripts/check.mjs all",
    "test:installers": "node scripts/test-installers.mjs"
  }
}
